# PostgreSQL Connection String
DATABASE_URL="postgresql://acc_app_user:PASSWORD_ANDA@localhost:5432/acc_db"

# Server Port (default: 3000)
PORT=3000

# Default Admin Credentials (digunakan saat pertama kali inisialisasi tabel kosong)
ADMIN_EMAIL="admin@acc.co.id"
ADMIN_PASSWORD="GANTI_DENGAN_PASSWORD_ADMIN_KUAT"

# Session Secret / Cookie Settings
NODE_ENV="production"
